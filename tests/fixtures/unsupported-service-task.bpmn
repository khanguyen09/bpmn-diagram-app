<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  id="Definitions_Unsupported"
  targetNamespace="https://the-experience.blogs/bpmn">
  <bpmn:process id="Process_Unsupported">
    <bpmn:serviceTask id="ServiceTask_Unsupported" name="Must be rejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Unsupported">
    <bpmndi:BPMNPlane id="Plane_Unsupported" bpmnElement="Process_Unsupported">
      <bpmndi:BPMNShape id="Shape_Unsupported" bpmnElement="ServiceTask_Unsupported">
        <dc:Bounds x="120" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
